{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "maison",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },

  // Un seul Worker sert l'API et le SPA.
  // `run_worker_first` empêche le fallback SPA d'avaler les routes /api/*
  // (sans lui, une URL d'API inconnue renverrait index.html en 200).
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    // Sans ça, `/sonde.html` répond 307 vers `/sonde` : une redirection de
    // plus à traverser sur la tablette, et une URL différente de celle que
    // sert `vite preview`. On garde les chemins littéraux.
    "html_handling": "none",
    "run_worker_first": ["/api/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "maison",
      "database_id": "REMPLACER_APRES_wrangler_d1_create",
      "migrations_dir": "migrations"
    }
  ]
}
